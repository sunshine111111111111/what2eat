/* me.wxss */
.page { padding-bottom: 40rpx; }
.center { text-align: center; }
.note { margin-top: 20rpx; }

.label2 { margin: 24rpx 0 6rpx; color: #5a6068; font-size: 26rpx; }
.switch-row { justify-content: space-between; margin-top: 24rpx; }
.switch-row .label { width: auto; flex: 1; }

.picker { flex: 1; }
.picker-text { background: #f2f3f5; border-radius: 12rpx; padding: 14rpx 18rpx; font-size: 28rpx; }

.btn-danger {
  background: #fff;
  color: #e53935;
  border: 1rpx solid #ffcdd2;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.link-row { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; font-size: 28rpx; border-bottom: 1rpx solid #f2f3f5; }
.link-arrow { color: #c0c4cc; font-size: 32rpx; }
.amap-note { margin-top: 16rpx; }
