/* today.wxss */
.page { padding-bottom: 40rpx; }

.label2 { margin: 24rpx 0 6rpx; color: #5a6068; font-size: 26rpx; }
.switch-row { justify-content: space-between; margin-top: 24rpx; }
.switch-row .label { width: auto; flex: 1; }

.picker { flex: 1; }
.picker-text { background: #f2f3f5; border-radius: 12rpx; padding: 14rpx 18rpx; font-size: 28rpx; }

/* 预算卡 */
.budget-top { display: flex; justify-content: space-between; align-items: flex-start; }
.budget-left { flex: 1; }
.date { font-size: 24rpx; color: #8a8f99; }
.kcal-line { margin-top: 10rpx; font-size: 28rpx; }
.big { font-size: 64rpx; font-weight: 700; color: #ff7d00; }
.meta { margin-top: 6rpx; font-size: 26rpx; color: #5a6068; }
.indulge { display: flex; flex-direction: column; align-items: center; margin-left: 20rpx; }
.indulge-label { font-size: 22rpx; color: #8a8f99; margin-top: 4rpx; }
.debt { margin-top: 14rpx; font-size: 24rpx; color: #e58900; }
.quota-line { display: flex; gap: 0; margin-top: 18rpx; font-size: 26rpx; color: #5a6068; }
.quota-line text { margin-right: 28rpx; }
.budget .dim { margin-top: 12rpx; }

/* 建议卡 */
.advice { display: flex; align-items: flex-start; }
.advice-tag { flex-shrink: 0; background: #fff3e8; color: #ff7d00; font-size: 22rpx; padding: 6rpx 14rpx; border-radius: 8rpx; margin-right: 16rpx; }
.advice-text { font-size: 26rpx; line-height: 1.6; color: #33373d; }

/* 推荐卡 */
.combo-head { font-size: 26rpx; color: #8a8f99; margin-bottom: 16rpx; }
.combo-main { padding: 10rpx 0; }
.combo-name { font-size: 40rpx; font-weight: 700; }
.combo-sub { margin-top: 6rpx; font-size: 26rpx; color: #5a6068; }
.combo-drink { display: flex; justify-content: space-between; padding: 14rpx 0; border-top: 1rpx dashed #eef0f3; font-size: 30rpx; }
.combo-drink-kcal { color: #5a6068; font-size: 26rpx; }
.combo-total { margin-top: 10rpx; font-size: 28rpx; font-weight: 600; }
.combo-note { margin-top: 10rpx; font-size: 24rpx; color: #8a8f99; line-height: 1.6; }
.btns { display: flex; gap: 20rpx; }
.btns .btn-half { flex: 1; margin-top: 30rpx; }
.btns .btn-half + .btn-half { margin-top: 30rpx; margin-left: 20rpx; }
.combo-empty { font-size: 28rpx; color: #5a6068; margin-bottom: 8rpx; }

/* 已吃列表 */
.eaten-item { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f2f3f5; font-size: 26rpx; }
.eaten-item:last-child { border-bottom: none; }
.eaten-meal { width: 90rpx; color: #ff7d00; font-size: 22rpx; flex-shrink: 0; }
.eaten-name { flex: 1; }
.eaten-kcal { color: #8a8f99; }

.footer { margin: 28rpx 0 20rpx; text-align: center; }

/* 步数行 */
.steps-row { display: flex; align-items: center; margin-top: 18rpx; }
.steps-label { font-size: 24rpx; color: #5a6068; }
.steps-input { width: 140rpx; background: #f2f3f5; border-radius: 8rpx; padding: 6rpx 12rpx; font-size: 26rpx; margin: 0 14rpx; text-align: center; }
.steps-bonus { font-size: 24rpx; color: #2eae60; }
.steps-tip { font-size: 22rpx; color: #c0c4cc; }

/* 找店入口 */
.find-shop { margin-top: 16rpx; font-size: 24rpx; color: #ff7d00; }

/* 附近面板 */
.nearby-head { display: flex; justify-content: space-between; align-items: center; }
.nearby-close { font-size: 24rpx; color: #8a8f99; padding: 6rpx 10rpx; }
.nearby-chips { display: flex; flex-wrap: wrap; margin: 6rpx 0 10rpx; }
.chip { font-size: 22rpx; color: #5a6068; background: #f2f3f5; border-radius: 24rpx; padding: 8rpx 20rpx; margin: 8rpx 12rpx 0 0; }
.chip.on { background: #ff7d00; color: #fff; }
.nearby-msg { padding: 30rpx 0; text-align: center; font-size: 26rpx; color: #8a8f99; }
.nearby-msg.err { color: #e53935; }
.shop { padding: 16rpx 0; border-bottom: 1rpx solid #f2f3f5; }
.shop:last-child { border-bottom: none; }
.shop-name { font-size: 28rpx; }
.shop-dist { float: right; font-size: 22rpx; color: #ff7d00; }
.shop-sub { font-size: 22rpx; color: #8a8f99; margin-top: 4rpx; }
.nearby-tip { margin-top: 16rpx; text-align: center; }
